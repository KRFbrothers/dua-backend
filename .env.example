# Copy to .env and fill values on the machine that runs the servers.
# Never commit .env. These names are empty on purpose.

# --- UI client (read by the new UI, not by these servers) ---
# Node API origin, no trailing path. Example: http://127.0.0.1:3000
API_BASE_URL=
# Python engine origin. Dua Agent chat calls this directly. Example: http://127.0.0.1:8081
ENGINE_BASE_URL=

# --- Shared ---
# Exact browser origins, comma-separated. No wildcard. Android sends no Origin and does not need this.
# Example: http://localhost:5173,http://127.0.0.1:5173
WEB_ORIGINS=
# Optional extra gate. If set, clients must send the same value in X-Dua-App-Token.
DUA_APP_TOKEN=
# Owner login. The engine requires this even when DUA_REQUIRE_LOGIN=0.
DUA_ALLOWED_EMAIL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Publishable key is an alternative to SUPABASE_ANON_KEY on the engine. Do not put a service-role key here.
SUPABASE_PUBLISHABLE_KEY=

# --- Node API (apps/api) ---
PORT=3000
SUPABASE_SERVICE_ROLE_KEY=
DUA_REQUIRE_LOGIN=
DUA_DAILY_REQUEST_LIMIT=
DUA_ENGINE_URL=
DUA_CHAT_DEADLINE_SECONDS=280
DUA_FILES_BUCKET=dua-files
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GROK_API_KEY=
GROK_MODEL=
KIMI_API_KEY=
KIMI_MODEL=
BRAVE_SEARCH_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GITHUB_TOKEN=
GITHUB_BUILD_WRITE_TOKEN=

# --- Python engine (apps/ai-engine) ---
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash
AGENT_MODEL=
VERTEX_THINKING_LEVEL=low
OPENROUTER_API_KEY=

# --- Kill switches (both processes read their own environment) ---
DUA_MAINTENANCE=
DUA_MAINTENANCE_MESSAGE=
DUA_DISABLE_AGENT=
DUA_DISABLE_IMAGINE=
DUA_DISABLE_VOICE=
