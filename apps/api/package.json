{
  "name": "dua-chat",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server/server.mjs",
    "worker:workflows": "node --env-file-if-exists=.env src/core/workflow-runtime.mjs",
    "worker:provision": "node --env-file-if-exists=.env src/core/workflow-identity.mjs provision",
    "worker:revoke": "node --env-file-if-exists=.env src/core/workflow-identity.mjs revoke",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=backend-test-results.xml \"test/**/*.test.mjs\"",
    "verify:rls": "node scripts/verify-rls.mjs",
    "verify:rls:cross": "node scripts/verify-rls-cross-tenant.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "unpdf": "2.1.0",
    "cfb": "1.2.2"
  }
}
