[Unit]
Description=Dua owner workflow worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=dua-workflow
Group=dua-workflow
WorkingDirectory=/opt/dua/apps/api
EnvironmentFile=/etc/dua/workflow-worker.env
ExecStart=/usr/bin/node /opt/dua/apps/api/src/core/workflow-runtime.mjs
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitCORE=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
