# Template only. Populate via server secret management; never commit a filled copy.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Quota, Imagine, live voice and account deletion only; not for workflow tables.
SUPABASE_SERVICE_ROLE_KEY=
DUA_ALLOWED_EMAIL=
DUA_WORKFLOW_OWNER_ID=
DUA_WORKFLOW_CREDENTIAL_KEY=
# Name only (default DUA_WORKFLOW_OWNER_SESSION). The sealed owner session is
# read and rotated through Secret Manager :latest + addVersion, never pinned
# into this file or as a Cloud Run env binding.
# DUA_WORKFLOW_OWNER_SESSION_SECRET=DUA_WORKFLOW_OWNER_SESSION
# GOOGLE_CLOUD_PROJECT=
DUA_ENGINE_URL=
DUA_APP_TOKEN=
DUA_WORKFLOWS_ENABLED=0
DUA_WORKFLOW_AUTOMATION_ENABLED=0
DUA_REQUIRE_LOGIN=1
# Copy existing quota and kill-switch configuration from the API/engine.
# DUA_DAILY_REQUEST_LIMIT, DUA_MINUTE_REQUEST_LIMIT
# DUA_MAINTENANCE, DUA_MAINTENANCE_MESSAGE, DUA_DISABLE_AGENT
# DUA_WORKFLOW_BOOTSTRAP_REFRESH_TOKEN is a ONE-TIME operator secret only.
# Do not set DUA_WORKFLOW_OWNER_TOKEN_FILE; access-only credentials are rejected.
